{
  "expo": {
    "name": "Multi-Lingua",
    "slug": "multi-lingua",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "multilingua",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.lucaslimasec.multilingua",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 31
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O $(PRODUCT_NAME) usa o microfone para você praticar a fala.",
          "speechRecognitionPermission": "O $(PRODUCT_NAME) usa o reconhecimento de voz do aparelho para conferir o que você falou.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0960d7d9-7071-4841-8e47-7f412a19e6c6"
      }
    },
    "owner": "zoraos"
  }
}
