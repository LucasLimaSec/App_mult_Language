        }
      ]
    },
    {
      "id": "zh-u02-l03",
      "titulo": "Are you Chinese?",
      "explicacao": [
        {
          "tipo": "texto",
          "texto": "是 shì links two nouns: 我是学生 (I am a student). It is not used with adjectives: \"I am tired\" is 我很累, not 我是累."
        },
        {
          "tipo": "texto",
          "texto": "To turn a sentence into a yes-no question, add 吗 ma at the end: 你是学生吗？ (Are you a student?) Chinese has no single word for \"yes\": answer with 是 or 不是."
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Chinese",
            "Pinyin",
            "Meaning"
          ],
          "linhas": [
            [
              "中国人",
              "Zhōng guó rén",
              "Chinese (person)"
            ],
            [
              "巴西人",
              "Bā xī rén",
              "Brazilian"
            ],
            [
              "美国人",
              "Měi guó rén",
              "American"
            ],
            [
              "墨西哥人",
              "Mò xī gē rén",
              "Mexican"
            ],
            [
              "日本人",
              "Rì běn rén",
              "Japanese"
            ]
          ]
        },
        {
          "tipo": "dica",
          "texto": "Nationality = country + 人 rén (person): 巴西 Brazil → 巴西人 Brazilian."
        },
        {
          "tipo": "texto",
          "texto": "Negate 是 with 不: 我不是老师. Remember the tone change: 不是 is said bú shì."
        },
        {
          "tipo": "texto",
          "texto": "To ask someone's nationality: 你是哪国人？ nǐ shì nǎ guó rén? (Literally: you are which-country person?)"
        }
      ],
      "exemplos": [
        {
          "frase": "我是巴西人。",
          "pinyin": "wǒ shì Bā xī rén",
          "en": "I'm Brazilian.",
          "pt": "Sou brasileiro."
        },
        {
          "frase": "你是中国人吗？",
          "pinyin": "nǐ shì Zhōng guó rén ma",
          "en": "Are you Chinese?",
          "pt": "Você é chinês?"
        },
        {
          "frase": "不是，我是美国人。",
          "pinyin": "bú shì wǒ shì Měi guó rén",
          "en": "No, I'm American.",
          "pt": "Não, sou americano."
        },
        {
          "frase": "你是哪国人？",
          "pinyin": "nǐ shì nǎ guó rén",
          "en": "Where are you from?",
          "pt": "De que país você é?"
        },
        {
          "frase": "他是老师，我是学生。",
          "pinyin": "tā shì lǎo shī wǒ shì xué sheng",
          "en": "He's a teacher, I'm a student.",
          "pt": "Ele é professor, eu sou aluno."
        }
      ],
      "palavras": [
        {
          "palavra": "巴西",
          "pinyin": "Bā xī",
          "classe": "noun",
          "en": "Brazil",
          "pt": "Brasil"
        },
        {
          "palavra": "中国人",
          "pinyin": "Zhōng guó rén",
          "classe": "noun",
