    {
      "id": "zh-u02-l01",
      "titulo": "Hello and goodbye",
      "explicacao": [
        {
          "tipo": "texto",
          "texto": "你好 nǐ hǎo is the basic greeting. To greet a group, say 你们好. To greet someone politely, such as an older person or a customer, say 您好 nín hǎo."
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Chinese",
            "Pinyin",
            "Meaning"
          ],
          "linhas": [
            [
              "你好",
              "nǐ hǎo",
              "hello"
            ],
            [
              "您好",
              "nín hǎo",
              "hello (polite)"
            ],
            [
              "你们好",
              "nǐ men hǎo",
              "hello, everyone"
            ],
            [
              "早上好",
              "zǎo shang hǎo",
              "good morning"
            ],
            [
              "晚上好",
              "wǎn shang hǎo",
              "good evening"
            ],
            [
              "再见",
              "zài jiàn",
              "goodbye"
            ],
            [
              "明天见",
              "míng tiān jiàn",
              "see you tomorrow"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Close friends rarely say 你好 to each other: they just say the name. As a learner, 你好 is always fine."
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Chinese",
            "Pinyin",
            "Meaning"
          ],
          "linhas": [
            [
              "谢谢",
              "xiè xie",
              "thank you"
            ],
            [
              "不客气",
              "bú kè qi",
              "you're welcome"
            ],
            [
              "对不起",
              "duì bu qǐ",
              "sorry"
            ],
            [
              "没关系",
              "méi guān xi",
              "it's OK, never mind"
            ]
          ]
        },
        {
          "tipo": "dica",
          "texto": "您 nín, the polite \"you\", has 心 (heart) at the bottom: an easy way to remember that it shows respect."
        }
      ],
      "exemplos": [
        {
          "frase": "你好！",
          "pinyin": "nǐ hǎo",
          "en": "Hello!",
          "pt": "Olá!"
        },
        {
          "frase": "老师好！",
          "pinyin": "lǎo shī hǎo",
          "en": "Hello, teacher!",
          "pt": "Bom dia, professor!"
        },
        {
          "frase": "谢谢你。",
          "pinyin": "xiè xie nǐ",
          "en": "Thank you.",
          "pt": "Obrigado."
        },
        {
          "frase": "不客气。",
          "pinyin": "bú kè qi",
          "en": "You're welcome.",
          "pt": "De nada."
        },
        {
          "frase": "明天见！",
          "pinyin": "míng tiān jiàn",
          "en": "See you tomorrow!",
          "pt": "Até amanhã!"
        }
      ],
      "palavras": [
        {
