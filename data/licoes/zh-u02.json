    {
      "id": "zh-u02-l02",
      "titulo": "What's your name?",
      "explicacao": [
        {
          "tipo": "texto",
          "texto": "To ask a name, say 你叫什么名字？nǐ jiào shén me míng zi? Word by word: you / are called / what / name."
        },
        {
          "tipo": "texto",
          "texto": "Answer with 我叫... wǒ jiào... (I am called...). In Chinese the question word stays in the place of the answer: 你叫什么？→ 我叫李明。"
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Chinese",
            "Pinyin",
            "Meaning"
          ],
          "linhas": [
            [
              "你叫什么名字？",
              "nǐ jiào shén me míng zi",
              "What's your name?"
            ],
            [
              "我叫李明。",
              "wǒ jiào Lǐ Míng",
              "My name is Li Ming."
            ],
            [
              "您贵姓？",
              "nín guì xìng",
              "What is your surname? (polite)"
            ],
            [
              "我姓李。",
              "wǒ xìng Lǐ",
              "My surname is Li."
            ]
          ]
        },
        {
          "tipo": "dica",
          "texto": "Chinese names put the surname first: in 李明, 李 Lǐ is the family name and 明 Míng is the given name."
        },
        {
          "tipo": "texto",
          "texto": "呢 ne turns the question back to the other person: 我叫Lucas，你呢？ (My name is Lucas, and you?)"
        },
        {
          "tipo": "dica",
          "texto": "Chinese verbs never change form: 我叫, 你叫 and 他叫 all use the same 叫."
        }
      ],
      "exemplos": [
        {
          "frase": "你叫什么名字？",
          "pinyin": "nǐ jiào shén me míng zi",
          "en": "What's your name?",
          "pt": "Como você se chama?"
        },
        {
          "frase": "我叫李明。",
          "pinyin": "wǒ jiào Lǐ Míng",
          "en": "My name is Li Ming.",
          "pt": "Eu me chamo Li Ming."
        },
        {
          "frase": "我叫安娜，你呢？",
          "pinyin": "wǒ jiào Ān nà nǐ ne",
          "en": "I'm Ana, and you?",
          "pt": "Eu sou a Ana, e você?"
        },
        {
          "frase": "她叫什么名字？",
          "pinyin": "tā jiào shén me míng zi",
          "en": "What's her name?",
          "pt": "Como ela se chama?"
        },
        {
          "frase": "认识你很高兴。",
          "pinyin": "rèn shi nǐ hěn gāo xìng",
          "en": "Nice to meet you.",
          "pt": "Prazer em conhecer você."
        }
      ],
      "palavras": [
        {
          "palavra": "姓",
          "pinyin": "xìng",
          "classe": "verb",
          "en": "to be surnamed; surname",
          "pt": "ter o sobrenome; sobrenome"
        },
        {
          "palavra": "贵姓",
          "pinyin": "guì xìng",
          "classe": "phrase",
          "en": "your surname (polite)",
          "pt": "seu sobrenome (formal)"
        },
        {
          "palavra": "认识你很高兴",
          "pinyin": "rèn shi nǐ hěn gāo xìng",
          "classe": "phrase",
          "en": "nice to meet you",
          "pt": "prazer em conhecer você"
        }
      ],
      "exercicios": [
        {
          "tipo": "escolha",
          "pergunta": "How do you ask a friend's name?",
          "opcoes": [
            "你叫什么名字？",
            "你是谁名字？",
            "什么你叫名字？",
            "你名字叫吗？"
          ],
          "correta": 0
        },
        {
          "tipo": "escolha",
          "pergunta": "In 李明, which part is the surname?",
          "opcoes": [
            "李 Lǐ",
            "明 Míng",
            "both",
            "neither"
          ],
          "correta": 0
        },
        {
          "tipo": "montar",
          "traducao": "My name is Li Ming.",
          "blocos": [
            "我",
            "叫",
            "李明"
          ],
          "extras": [
            "是",
            "你"
          ],
          "pinyin": "wǒ jiào Lǐ Míng"
        },
        {
          "tipo": "ouvir",
          "audio": "你呢？",
          "pergunta": "What did you hear?",
          "opcoes": [
            "And you?",
            "Who are you?",
            "Hello!",
            "What's your name?"
          ],
          "correta": 0
        },
        {
          "tipo": "escolha",
          "pergunta": "What does 呢 do in 我叫Lucas，你呢？",
          "opcoes": [
            "asks the same question back",
            "makes the sentence negative",
            "means \"name\"",
            "says goodbye"
          ],
          "correta": 0
        },
        {
          "tipo": "ditado",
          "frase": "名字",
          "resposta": "míng zi",
          "traducao": "name",
          "explicacao": "The second syllable has a neutral tone: ming2 zi."
        },
        {
          "tipo": "montar",
          "traducao": "What's her name?",
          "blocos": [
            "她",
            "叫",
            "什么",
            "名字"
          ],
          "extras": [
            "吗",
            "你"
          ],
          "pinyin": "tā jiào shén me míng zi"
        },
        {
          "tipo": "falar",
