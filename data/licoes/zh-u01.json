            "mà"
          ],
          "correta": 2
        },
        {
          "tipo": "ouvir",
          "audio": "骂",
          "pergunta": "Which tone did you hear?",
          "opcoes": [
            "mā",
            "má",
            "mǎ",
            "mà"
          ],
          "correta": 3
        },
        {
          "tipo": "escolha",
          "pergunta": "Which tone falls sharply, like a firm \"no!\"?",
          "opcoes": [
            "1st tone",
            "2nd tone",
            "3rd tone",
            "4th tone"
          ],
          "correta": 3
