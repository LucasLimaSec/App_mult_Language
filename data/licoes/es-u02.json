    {
      "id": "es-u02-l02",
      "titulo": "How old are you?",
      "explicacao": [
        {
          "tipo": "texto",
          "texto": "Spanish uses tener (to have) for age, just like Portuguese: \"Tengo treinta años.\" To ask: \"¿Cuántos años tienes?\", or formally \"¿Cuántos años tiene?\""
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Person",
            "tener"
          ],
          "linhas": [
            [
              "yo",
              "tengo"
            ],
            [
              "tú",
              "tienes"
            ],
            [
              "usted, él, ella",
              "tiene"
            ],
            [
              "nosotros",
              "tenemos"
            ],
            [
              "ustedes, ellos, ellas",
              "tienen"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "From 21 to 29 the numbers are one word: veintiuno, veintidós, veintitrés... From 31 on they use \"y\": treinta y uno, cuarenta y dos."
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Number",
            "Spanish"
          ],
          "linhas": [
            [
              "20",
              "veinte"
            ],
            [
              "30",
              "treinta"
            ],
            [
              "40",
              "cuarenta"
            ],
            [
              "50",
              "cincuenta"
            ],
            [
              "60",
              "sesenta"
            ],
            [
              "70",
              "setenta"
            ],
            [
              "80",
              "ochenta"
            ],
            [
              "90",
              "noventa"
            ],
            [
              "100",
              "cien"
            ]
          ]
        },
        {
          "tipo": "dica",
          "texto": "Keep the ñ: \"años\" means years. Without it, \"anos\" is a very different (and rude) word."
        },
        {
          "tipo": "dica",
          "texto": "Spanish also uses tener where Portuguese says \"estar com\": tengo hambre (estou com fome), tengo frío, tengo sueño."
        }
      ],
      "exemplos": [
        {
          "frase": "¿Cuántos años tienes?",
          "en": "How old are you?",
          "pt": "Quantos anos você tem?"
        },
        {
          "frase": "Tengo treinta y cuatro años.",
          "en": "I'm thirty-four years old.",
          "pt": "Tenho trinta e quatro anos."
        },
        {
          "frase": "Mi abuela tiene ochenta y dos años.",
          "en": "My grandmother is eighty-two.",
          "pt": "Minha avó tem oitenta e dois anos."
        },
        {
          "frase": "Mañana cumplo cuarenta años.",
          "en": "Tomorrow I'm turning forty.",
          "pt": "Amanhã faço quarenta anos."
        },
        {
          "frase": "Tengo hambre, ¿comemos?",
          "en": "I'm hungry, shall we eat?",
          "pt": "Estou com fome, vamos comer?"
        }
      ],
      "palavras": [
        {
          "palavra": "treinta",
          "classe": "numeral",
          "en": "thirty",
          "pt": "trinta",
          "exemplo": "Tengo treinta años.",
          "exemploEn": "I'm thirty.",
          "exemploPt": "Tenho trinta anos."
        },
        {
