    {
      "id": "es-u02-l03",
      "titulo": "Phone numbers and spelling",
      "explicacao": [
        {
          "tipo": "texto",
          "texto": "To ask for a phone number: \"¿Cuál es tu número de teléfono?\" In Mexico people also say \"tu celular\". Numbers are usually read in pairs: 55 12 34 56 78 is \"cincuenta y cinco, doce, treinta y cuatro...\""
        },
        {
          "tipo": "texto",
          "texto": "To ask for an email: \"¿Cuál es tu correo?\" The symbol @ is \"arroba\" and the dot is \"punto\"."
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Letter",
            "Name",
            "How it sounds"
          ],
          "linhas": [
            [
              "h",
              "hache",
              "always silent: hola sounds like \"ola\""
            ],
            [
              "j",
              "jota",
              "a strong sound from the throat, like the rr in \"carro\""
            ],
            [
              "ll",
              "doble ele",
              "in Mexico, like the y in English \"yes\""
            ],
            [
              "ñ",
              "eñe",
              "like the Portuguese \"nh\": año"
            ],
            [
              "v",
              "ve chica",
              "exactly the same sound as b"
            ],
            [
              "z",
              "zeta",
              "in Latin America, like an s"
            ],
            [
              "y",
              "ye",
              "like ll; alone it means \"and\" and sounds like \"i\""
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "To ask how something is spelled, say \"¿Cómo se escribe?\" Then spell it letter by letter: Lucas = ele, u, ce, a, ese."
        },
        {
          "tipo": "dica",
          "texto": "Spanish uses \"cuál\", not \"qué\", to ask for a piece of information: ¿Cuál es tu nombre? ¿Cuál es tu correo?"
        }
      ],
      "exemplos": [
        {
          "frase": "¿Cuál es tu número de teléfono?",
          "en": "What's your phone number?",
          "pt": "Qual é o seu número de telefone?"
        },
        {
          "frase": "Es el cincuenta y cinco, doce, treinta y cuatro.",
          "en": "It's fifty-five, twelve, thirty-four.",
          "pt": "É cinquenta e cinco, doze, trinta e quatro."
        },
        {
          "frase": "¿Cómo se escribe tu apellido?",
          "en": "How do you spell your last name?",
          "pt": "Como se escreve o seu sobrenome?"
        },
        {
          "frase": "Mi correo es lucas arroba ejemplo punto com.",
          "en": "My email is lucas at ejemplo dot com.",
          "pt": "Meu e-mail é lucas arroba ejemplo ponto com."
        },
        {
          "frase": "La hache no se pronuncia.",
          "en": "The h is not pronounced.",
          "pt": "O h não se pronuncia."
        }
      ],
      "palavras": [
        {
