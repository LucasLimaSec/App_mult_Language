          ]
        },
        {
          "tipo": "dica",
          "texto": "Careful: \"doce\" is 12 (sweet is \"dulce\"), and 11 is \"once\", spelled with c."
        },
        {
          "tipo": "texto",
          "texto": "\"Uno\" becomes \"un\" before a masculine noun and \"una\" before a feminine noun: un libro, una casa."
        },
        {
          "tipo": "texto",
          "texto": "\"Hay\" means there is or there are, for one thing or many: Hay un problema. Hay tres personas."
        }
      ],
      "exemplos": [
        {
          "frase": "Hay doce estudiantes en la clase.",
          "en": "There are twelve students in the class.",
          "pt": "Há doze alunos na turma."
        },
        {
          "frase": "Tengo dos hermanos y una hermana.",
          "en": "I have two brothers and one sister.",
          "pt": "Tenho dois irmãos e uma irmã."
        },
        {
          "frase": "¿Cuántos son? Son quince.",
          "en": "How many are there? Fifteen.",
          "pt": "Quantos são? São quinze."
        },
        {
          "frase": "Mi número favorito es el siete.",
          "en": "My favorite number is seven.",
          "pt": "Meu número favorito é o sete."
        },
        {
          "frase": "Hay un problema con mi tarjeta.",
          "en": "There's a problem with my card.",
          "pt": "Há um problema com o meu cartão."
        }
      ],
      "palavras": [
