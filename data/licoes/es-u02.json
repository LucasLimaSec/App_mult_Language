    {
      "id": "es-u02-l01",
      "titulo": "Numbers 0 to 20",
      "explicacao": [
        {
          "tipo": "texto",
          "texto": "Numbers from 0 to 15 have their own names. From 16 to 19 they join diez + y + the unit into one word: dieciséis (10 + 6)."
        },
        {
          "tipo": "tabela",
          "cabecalho": [
