{
  "id": "zh-u03",
  "idioma": "zh",
  "titulo": "Numbers and age",
  "licoes": [
    {
      "id": "zh-u03-l01",
      "titulo": "Counting to 100",
      "explicacao": [
        {
          "tipo": "texto",
          "texto": "Chinese numbers are very regular: learn 1 to 10 and you can build every number up to 99."
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Number",
            "Chinese",
            "Pinyin"
          ],
          "linhas": [
            [
              "0",
              "零",
              "líng"
            ],
            [
              "1",
              "一",
              "yī"
            ],
            [
              "2",
              "二",
              "èr"
            ],
            [
              "3",
              "三",
              "sān"
            ],
            [
              "4",
              "四",
              "sì"
            ],
            [
              "5",
              "五",
              "wǔ"
            ],
            [
              "6",
              "六",
              "liù"
            ],
            [
              "7",
              "七",
              "qī"
            ],
            [
              "8",
              "八",
              "bā"
            ],
            [
              "9",
              "九",
              "jiǔ"
            ],
            [
              "10",
              "十",
              "shí"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "11 to 19 are 十 + the unit: 十一 shí yī (11), 十五 shí wǔ (15). The tens are unit + 十: 二十 èr shí (20), 三十 sān shí (30). Then add the unit: 二十五 èr shí wǔ (25), 九十九 jiǔ shí jiǔ (99). 100 is 一百 yì bǎi."
        },
        {
          "tipo": "dica",
          "texto": "In China, the numbers 1 to 10 have hand signs. Six is the thumb and the little finger, just like the Brazilian \"hang loose\"."
        },
        {
          "tipo": "dica",
          "texto": "四 sì sounds like 死 sǐ (death), so many buildings in China skip the 4th floor."
        }
      ],
      "exemplos": [
        {
          "frase": "十一",
          "pinyin": "shí yī",
          "en": "eleven",
          "pt": "onze"
        },
        {
          "frase": "二十",
          "pinyin": "èr shí",
          "en": "twenty",
          "pt": "vinte"
        },
        {
          "frase": "三十五",
          "pinyin": "sān shí wǔ",
          "en": "thirty-five",
          "pt": "trinta e cinco"
        },
        {
          "frase": "九十九",
          "pinyin": "jiǔ shí jiǔ",
          "en": "ninety-nine",
          "pt": "noventa e nove"
        },
        {
          "frase": "一百",
          "pinyin": "yì bǎi",
          "en": "one hundred",
          "pt": "cem"
        }
      ],
      "palavras": [
        {
          "palavra": "一百",
          "pinyin": "yì bǎi",
          "classe": "numeral",
          "en": "one hundred",
          "pt": "cem"
        },
        {
          "palavra": "号码",
          "pinyin": "hào mǎ",
          "classe": "noun",
          "en": "number (phone, room)",
          "pt": "número (de telefone, quarto)"
        }
      ],
