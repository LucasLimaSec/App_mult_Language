            "两",
            "个",
            "哥哥"
          ],
          "extras": [
            "二",
            "是"
          ],
          "pinyin": "wǒ yǒu liǎng gè gē ge"
        },
        {
          "tipo": "escolha",
          "pergunta": "\"A cup of tea\":",
          "opcoes": [
            "一杯茶",
            "一茶",
            "杯一茶",
            "茶一杯一"
          ],
          "correta": 0
        },
        {
          "tipo": "ditado",
