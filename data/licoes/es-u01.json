          "exemplo": "Me voy, hasta mañana.",
          "exemploEn": "I'm leaving, see you tomorrow.",
          "exemploPt": "Estou indo, até amanhã."
        },
        {
          "palavra": "nos vemos",
          "classe": "phrase",
          "en": "see you",
          "pt": "a gente se vê",
          "exemplo": "Nos vemos el lunes.",
          "exemploEn": "See you on Monday.",
          "exemploPt": "A gente se vê na segunda."
        }
      ],
      "exercicios": [
