    {
      "id": "es-u01-l02",
      "titulo": "What's your name?",
      "explicacao": [
        {
          "tipo": "texto",
          "texto": "To give your name, say \"Me llamo...\" (literally \"I call myself...\") or simply \"Soy...\" (I am). To ask, say \"¿Cómo te llamas?\" to a friend and \"¿Cómo se llama?\" when you speak formally."
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Pronoun",
            "English",
            "ser (to be)"
          ],
          "linhas": [
            [
              "yo",
              "I",
              "soy"
            ],
            [
              "tú",
              "you (informal)",
              "eres"
            ],
            [
              "usted",
              "you (formal)",
              "es"
            ],
            [
              "él",
              "he",
              "es"
            ],
            [
              "ella",
              "she",
              "es"
            ]
          ]
        },
        {
          "tipo": "dica",
          "texto": "\"Usted\" means you, but it takes the same verb form as él and ella: \"Usted es muy amable\" (You are very kind)."
        },
        {
          "tipo": "texto",
          "texto": "In Mexico people use \"tú\" with friends, family, children and colleagues of their age, and \"usted\" with older people, customers, officials and strangers in formal situations. When in doubt, start with usted."
        },
        {
          "tipo": "texto",
          "texto": "When you meet someone, say \"Mucho gusto\" (nice to meet you). A man can also say \"Encantado\" and a woman \"Encantada\". The usual answer is \"Igualmente\" (likewise)."
        },
        {
          "tipo": "dica",
          "texto": "Spanish usually drops the subject pronoun, because the verb already shows who it is: \"Soy Lucas\" sounds more natural than \"Yo soy Lucas\"."
        }
      ],
      "exemplos": [
        {
          "frase": "¿Cómo te llamas?",
          "en": "What's your name?",
          "pt": "Como você se chama?"
        },
        {
          "frase": "Me llamo Lucas. ¿Y tú?",
          "en": "My name is Lucas. And you?",
          "pt": "Eu me chamo Lucas. E você?"
        },
        {
          "frase": "¿Cómo se llama usted?",
          "en": "What is your name? (formal)",
          "pt": "Como o senhor se chama?"
        },
        {
          "frase": "Ella es Ana, mi compañera de trabajo.",
          "en": "This is Ana, my coworker.",
          "pt": "Esta é a Ana, minha colega de trabalho."
        },
        {
          "frase": "Mucho gusto. Igualmente.",
          "en": "Nice to meet you. Likewise.",
          "pt": "Muito prazer. Igualmente."
        }
      ],
      "palavras": [
        {
          "palavra": "¿cómo te llamas?",
          "classe": "phrase",
          "en": "what's your name?",
          "pt": "como você se chama?",
          "exemplo": "Hola, ¿cómo te llamas?",
          "exemploEn": "Hi, what's your name?",
          "exemploPt": "Oi, como você se chama?"
        },
        {
          "palavra": "encantado",
          "classe": "adjective",
          "en": "delighted; nice to meet you",
          "pt": "encantado; muito prazer",
          "exemplo": "Encantado de conocerte.",
          "exemploEn": "Nice to meet you.",
          "exemploPt": "Prazer em conhecer você.",
          "nota": "A woman says \"encantada\"."
        },
        {
          "palavra": "igualmente",
          "classe": "adverb",
          "en": "likewise, same to you",
          "pt": "igualmente",
          "exemplo": "Mucho gusto. Igualmente.",
          "exemploEn": "Nice to meet you. Likewise.",
          "exemploPt": "Muito prazer. Igualmente."
        },
        {
          "palavra": "compañero",
          "classe": "noun",
          "en": "classmate, colleague, companion",
          "pt": "colega, companheiro",
          "exemplo": "Es mi compañero de clase.",
          "exemploEn": "He's my classmate.",
          "exemploPt": "Ele é meu colega de classe."
        }
      ],
      "exercicios": [
