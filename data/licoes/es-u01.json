    {
      "id": "es-u01-l03",
      "titulo": "Where are you from?",
      "explicacao": [
        {
          "tipo": "texto",
          "texto": "To say where you are from, use ser + de + place: \"Soy de Brasil.\" To ask, say \"¿De dónde eres?\" to a friend or \"¿De dónde es usted?\" formally."
        },
        {
          "tipo": "texto",
          "texto": "Nationalities are adjectives, so they agree with the person: a man is \"brasileño\" and a woman is \"brasileña\". They are written in lowercase."
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Country",
            "Man",
            "Woman"
          ],
          "linhas": [
            [
              "México",
              "mexicano",
              "mexicana"
            ],
            [
              "Brasil",
              "brasileño",
              "brasileña"
            ],
            [
              "España",
              "español",
              "española"
            ],
            [
              "Argentina",
              "argentino",
              "argentina"
            ],
            [
              "China",
              "chino",
              "china"
            ],
            [
              "Estados Unidos",
              "estadounidense",
              "estadounidense"
            ],
            [
              "Canadá",
              "canadiense",
              "canadiense"
            ]
          ]
        },
        {
          "tipo": "dica",
          "texto": "Nationalities ending in -e do not change for men and women: estadounidense, canadiense."
        },
        {
          "tipo": "texto",
          "texto": "To say where you live, use vivir with en: \"Vivo en São Paulo.\" Remember: de for where you come from, en for where you are."
        },
        {
          "tipo": "dica",
          "texto": "\"Brasileño\" is the most common form. In Argentina and Uruguay you will also hear \"brasilero\"."
        }
      ],
      "exemplos": [
        {
          "frase": "¿De dónde eres? Soy de Brasil.",
          "en": "Where are you from? I'm from Brazil.",
          "pt": "De onde você é? Sou do Brasil."
        },
        {
          "frase": "Soy brasileño, pero vivo en México.",
          "en": "I'm Brazilian, but I live in Mexico.",
          "pt": "Sou brasileiro, mas moro no México."
        },
        {
          "frase": "Ella es mexicana, de Guadalajara.",
          "en": "She's Mexican, from Guadalajara.",
          "pt": "Ela é mexicana, de Guadalajara."
        },
        {
          "frase": "¿De dónde es usted?",
          "en": "Where are you from? (formal)",
          "pt": "De onde o senhor é?"
        },
        {
          "frase": "Mi jefe es estadounidense.",
          "en": "My boss is American.",
          "pt": "Meu chefe é americano."
        }
      ],
      "palavras": [
        {
          "palavra": "¿de dónde?",
          "classe": "phrase",
