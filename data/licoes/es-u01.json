{
  "id": "es-u01",
  "idioma": "es",
  "titulo": "Hello!",
  "falsosAmigos": [
    {
      "palavra": "apellido",
      "significado": "surname, last name",
      "portugues": "Portuguese \"apelido\" (nickname) is \"apodo\" in Spanish.",
      "exemplo": "Mi apellido es Lima, pero mi apodo es Luquinha.",
      "exemploEn": "My last name is Lima, but my nickname is Luquinha."
    },
    {
      "palavra": "largo",
      "significado": "long",
      "portugues": "Portuguese \"largo\" (wide) is \"ancho\" in Spanish.",
      "exemplo": "Fue un viaje muy largo.",
      "exemploEn": "It was a very long trip."
    },
    {
      "palavra": "no",
      "significado": "no, not",
      "portugues": "Portuguese \"no\" (em + o, \"in the\") is \"en el\" in Spanish.",
      "exemplo": "No vivo en el centro.",
      "exemploEn": "I don't live downtown."
    }
  ],
  "licoes": [
    {
      "id": "es-u01-l01",
      "titulo": "Greetings and goodbyes",
      "explicacao": [
        {
          "tipo": "texto",
          "texto": "In Spanish, the greeting changes with the time of day. \"Hola\" works at any time and with anyone."
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Spanish",
            "When",
            "English"
          ],
          "linhas": [
            [
              "Hola",
              "any time",
              "hi, hello"
            ],
            [
              "Buenos días",
              "until about noon",
              "good morning"
            ],
            [
              "Buenas tardes",
              "from noon until dark",
              "good afternoon"
            ],
            [
              "Buenas noches",
              "after dark, and before bed",
              "good evening, good night"
            ]
          ]
        },
        {
          "tipo": "dica",
          "texto": "Portuguese says \"bom dia\" in the singular, but Spanish always uses the plural: buenos días, buenas tardes, buenas noches."
        },
        {
          "tipo": "texto",
          "texto": "To ask how someone is, say \"¿Cómo estás?\" to a friend and \"¿Cómo está?\" to someone you treat formally. \"¿Qué tal?\" works in both cases."
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Answer",
            "English"
          ],
          "linhas": [
            [
              "Muy bien, gracias. ¿Y tú?",
              "Very well, thanks. And you?"
            ],
            [
              "Bien.",
              "Fine."
            ],
            [
              "Más o menos.",
              "So-so."
            ],
            [
              "Mal.",
              "Not well."
            ]
          ]
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Goodbye",
            "English"
          ],
          "linhas": [
            [
              "Adiós",
              "goodbye"
            ],
            [
              "Hasta luego",
              "see you later"
            ],
            [
              "Hasta mañana",
              "see you tomorrow"
            ],
            [
              "Nos vemos",
              "see you"
            ],
            [
              "Que te vaya bien",
              "take care (literally: may it go well for you)"
            ]
          ]
        },
        {
          "tipo": "dica",
          "texto": "In Mexico you will often hear \"¿Qué onda?\" among friends. It is very informal, like \"E aí?\" in Portuguese."
        }
      ],
      "exemplos": [
        {
          "frase": "Buenos días, ¿cómo está?",
          "en": "Good morning, how are you?",
          "pt": "Bom dia, como o senhor está?"
        },
        {
          "frase": "Hola, ¿qué tal?",
          "en": "Hi, how's it going?",
          "pt": "Oi, tudo bem?"
        },
        {
          "frase": "Muy bien, gracias. ¿Y tú?",
          "en": "Very well, thanks. And you?",
          "pt": "Muito bem, obrigado. E você?"
        },
        {
          "frase": "Buenas noches, hasta mañana.",
          "en": "Good night, see you tomorrow.",
          "pt": "Boa noite, até amanhã."
        },
        {
          "frase": "Adiós, que te vaya bien.",
          "en": "Goodbye, take care.",
          "pt": "Tchau, tudo de bom."
        }
      ],
      "palavras": [
        {
          "palavra": "buenas tardes",
          "classe": "phrase",
          "en": "good afternoon",
          "pt": "boa tarde",
          "exemplo": "Buenas tardes, señora.",
