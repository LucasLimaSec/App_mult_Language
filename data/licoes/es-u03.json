          "classe": "noun",
          "en": "mustache",
          "pt": "bigode",
          "exemplo": "Mi abuelo tiene bigote.",
          "exemploEn": "My grandfather has a mustache.",
          "exemploPt": "Meu avô tem bigode."
        }
      ],
