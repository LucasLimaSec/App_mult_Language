{
  "id": "es-u03",
  "idioma": "es",
  "titulo": "My family",
  "falsosAmigos": [
    {
      "palavra": "padres",
      "significado": "parents",
      "portugues": "Portuguese \"pais\" is \"padres\" in Spanish. Portuguese \"padres\" (priests) are usually \"sacerdotes\".",
      "exemplo": "Mis padres viven en Curitiba.",
      "exemploEn": "My parents live in Curitiba."
    },
    {
      "palavra": "novio",
      "significado": "boyfriend; groom",
      "portugues": "Portuguese \"noivo\" (fiancé) is \"prometido\"; in Spanish \"novio\" is first of all a boyfriend.",
      "exemplo": "Mi hermana tiene novio.",
      "exemploEn": "My sister has a boyfriend."
    },
    {
      "palavra": "embarazada",
      "significado": "pregnant",
      "portugues": "Portuguese \"embaraçada\" (embarrassed) is \"avergonzada\", or \"apenada\" in Mexico.",
      "exemplo": "Mi prima está embarazada.",
      "exemploEn": "My cousin is pregnant."
    }
  ],
  "licoes": [
    {
      "id": "es-u03-l01",
      "titulo": "This is my family",
      "explicacao": [
        {
          "tipo": "texto",
          "texto": "To introduce someone, use \"Este es...\" for a man and \"Esta es...\" for a woman: \"Esta es mi madre.\""
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Spanish",
            "English",
            "Example"
          ],
          "linhas": [
            [
              "mi, mis",
              "my",
              "mi padre, mis padres"
            ],
            [
              "tu, tus",
              "your (informal)",
              "tu hermana, tus hijos"
            ],
            [
              "su, sus",
              "his, her, their, your (formal)",
              "su hijo, sus abuelos"
            ],
            [
              "nuestro, nuestra, nuestros, nuestras",
              "our",
              "nuestra casa, nuestros primos"
            ]
          ]
        },
        {
          "tipo": "dica",
          "texto": "Spanish never puts an article before these possessives: \"mi madre\", not \"la mi madre\" (Portuguese says \"a minha mãe\")."
        },
        {
          "tipo": "dica",
          "texto": "The masculine plural covers mixed groups: los padres = parents, los hermanos = brothers and sisters, los hijos = children."
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Spanish",
            "English"
          ],
          "linhas": [
            [
              "padre, madre",
              "father, mother"
            ],
            [
              "papá, mamá",
              "dad, mom"
            ],
            [
              "hermano, hermana",
              "brother, sister"
            ],
            [
              "hijo, hija",
              "son, daughter"
            ],
            [
              "abuelo, abuela",
              "grandfather, grandmother"
            ],
            [
              "esposo, esposa",
              "husband, wife"
            ],
            [
              "tío, tía",
              "uncle, aunt"
            ],
            [
              "primo, prima",
              "cousin"
            ]
          ]
        }
      ],
      "exemplos": [
        {
          "frase": "Esta es mi familia.",
          "en": "This is my family.",
          "pt": "Esta é a minha família."
        },
        {
          "frase": "Este es mi padre, y esta es mi madre.",
          "en": "This is my father, and this is my mother.",
          "pt": "Este é o meu pai, e esta é a minha mãe."
        },
        {
          "frase": "Mis padres viven en Curitiba.",
          "en": "My parents live in Curitiba.",
          "pt": "Meus pais moram em Curitiba."
        },
        {
          "frase": "¿Tienes hermanos?",
          "en": "Do you have any brothers or sisters?",
          "pt": "Você tem irmãos?"
        },
        {
          "frase": "Nuestra familia es pequeña.",
          "en": "Our family is small.",
          "pt": "A nossa família é pequena."
        }
      ],
      "palavras": [
        {
          "palavra": "familia",
          "classe": "noun",
          "en": "family",
          "pt": "família",
          "exemplo": "Mi familia es muy grande.",
          "exemploEn": "My family is very big.",
          "exemploPt": "Minha família é muito grande."
        },
        {
          "palavra": "padres",
          "classe": "noun",
          "en": "parents",
          "pt": "pais",
          "exemplo": "Mis padres están jubilados.",
          "exemploEn": "My parents are retired.",
          "exemploPt": "Meus pais são aposentados.",
          "nota": "False friend: \"padres\" means parents."
        },
        {
          "palavra": "tío",
          "classe": "noun",
          "en": "uncle",
          "pt": "tio",
          "exemplo": "Mi tío vive en Monterrey.",
          "exemploEn": "My uncle lives in Monterrey.",
          "exemploPt": "Meu tio mora em Monterrey.",
          "nota": "Aunt is \"tía\"."
        },
        {
          "palavra": "este",
          "classe": "determiner",
          "en": "this",
          "pt": "este",
          "exemplo": "Este es mi hermano.",
          "exemploEn": "This is my brother.",
          "exemploPt": "Este é o meu irmão.",
          "nota": "Feminine: \"esta\"."
        }
      ],
      "exercicios": [
