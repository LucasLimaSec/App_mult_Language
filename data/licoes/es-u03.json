    {
      "id": "es-u03-l03",
      "titulo": "What do they look like?",
      "explicacao": [
        {
          "tipo": "texto",
          "texto": "To say what someone is like, use ser + adjective: \"Mi hermano es alto.\" Adjectives agree with the noun: alto, alta, altos, altas."
        },
        {
          "tipo": "tabela",
          "cabecalho": [
            "Spanish",
            "English"
          ],
          "linhas": [
            [
              "alto, alta",
              "tall"
            ],
            [
              "bajo, baja",
              "short"
            ],
            [
              "delgado, delgada",
              "thin, slim"
            ],
            [
              "joven",
              "young"
            ],
            [
              "mayor",
              "older; elderly (polite)"
            ],
            [
              "guapo, guapa",
              "good-looking"
            ],
            [
              "moreno, morena",
              "dark-haired, dark-skinned"
            ],
            [
              "rubio, rubia",
              "blond"
            ],
            [
              "simpático, simpática",
              "nice, friendly"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "For hair and eyes, use tener with the article: \"Tiene el pelo negro y los ojos verdes.\""
        },
        {
          "tipo": "dica",
          "texto": "\"Rubio\" means blond. A redhead (ruivo in Portuguese) is \"pelirrojo\"."
        },
        {
          "tipo": "dica",
          "texto": "Adjectives ending in -e or in a consonant are the same for men and women: joven, amable, feliz."
        },
        {
          "tipo": "dica",
          "texto": "In Mexico, brown eyes and brown hair are usually \"cafés\": tiene los ojos cafés."
        }
      ],
      "exemplos": [
        {
          "frase": "Mi hermana es alta y delgada.",
          "en": "My sister is tall and slim.",
          "pt": "Minha irmã é alta e magra."
        },
        {
          "frase": "Mi papá tiene el pelo gris y los ojos cafés.",
          "en": "My dad has gray hair and brown eyes.",
          "pt": "Meu pai tem cabelo grisalho e olhos castanhos."
        },
        {
          "frase": "Mis primos son muy simpáticos.",
          "en": "My cousins are very nice.",
          "pt": "Meus primos são muito simpáticos."
        },
        {
          "frase": "Ella es morena y tiene el pelo largo.",
          "en": "She is dark-haired and has long hair.",
          "pt": "Ela é morena e tem cabelo comprido."
        },
        {
          "frase": "Mi abuelo es mayor, pero muy fuerte.",
          "en": "My grandfather is elderly, but very strong.",
          "pt": "Meu avô é idoso, mas muito forte."
        }
      ],
      "palavras": [
        {
          "palavra": "rubio",
          "classe": "adjective",
          "en": "blond",
          "pt": "loiro",
          "exemplo": "Su hijo es rubio.",
          "exemploEn": "Her son is blond.",
          "exemploPt": "O filho dela é loiro.",
          "nota": "False friend: a redhead (ruivo) is \"pelirrojo\"."
        },
        {
          "palavra": "pelirrojo",
          "classe": "adjective",
          "en": "red-haired",
          "pt": "ruivo",
          "exemplo": "Mi prima es pelirroja.",
          "exemploEn": "My cousin is a redhead.",
          "exemploPt": "Minha prima é ruiva."
        },
        {
          "palavra": "café",
          "classe": "adjective",
          "en": "brown (Mexico)",
          "pt": "marrom, castanho",
          "exemplo": "Tiene los ojos cafés.",
          "exemploEn": "He has brown eyes.",
          "exemploPt": "Ele tem olhos castanhos.",
          "nota": "As a color it does not change: ojos cafés, camisa café."
        },
        {
