    { "id": "es-freq-0004", "palavra": "muy", "classe": "adverb", "en": "very", "pt": "muito", "exemplo": "La comida está muy rica.", "exemploEn": "The food is very tasty.", "exemploPt": "A comida está muito gostosa.", "nota": "Use \"muy\" before adjectives and adverbs; \"mucho\" goes with nouns and verbs." },
